# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way. Every value below is a placeholder -- no real secret belongs in this
# file, which IS committed.
#
# `neon deploy` (or `neon env pull`) writes the real values into .env.local for
# you once neon.ts has been applied to the linked branch.
# ---------------------------------------------------------------------------

# --- Public: shipped to the browser ----------------------------------------
# These two are safe to expose. They are addresses, not credentials. Neither
# returns data without a valid JWT, and Row Level Security decides which rows
# that JWT can see.

# Managed Better Auth endpoint.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth

# Data API (PostgREST) endpoint.
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-123456.apirest.c-2.us-west-2.aws.neon.tech/neondb/rest/v1


# --- Server-only: never prefixed with NEXT_PUBLIC_ --------------------------
# Used by `npm run db:migrate` to apply db/migrations/*.sql. The running
# application never reads it: no file under src/ references DATABASE_URL.
# Anything with NEXT_PUBLIC_ is inlined into the client bundle at build time,
# which is exactly why this one must not have that prefix.
DATABASE_URL=postgresql://user:password@ep-example-123456.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require
